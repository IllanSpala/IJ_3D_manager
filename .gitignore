# ============================================================
# IJ 3D Manager - .gitignore (Python / CustomTkinter / SQLite)
# ============================================================

# -- Ambientes Virtuais ----------------------------------------
venv/
.venv/
env/
ENV/

# -- Python Cache & Bytecode ----------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyw

# -- Bancos de Dados (nao subir dados de producao/pessoais) ---
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# -- Midias e Arquivos Gerados pelo Usuario -------------------
media/
src_media/

# -- Backups exportados pelo aplicativo -----------------------
*.zip

# -- Build e Empacotamento (PyInstaller) ----------------------
build/
dist/
*.spec

# -- Variaveis de Ambiente e Segredos -------------------------
.env
.env.*
*.env

# -- IDEs e Editores ------------------------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/

# -- macOS / Windows / Linux Metadata -------------------------
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# -- Logs -----------------------------------------------------
*.log
logs/

# -- Scripts de Teste / Seed de Dados -------------------------
populate_test_data.py
generate_dummy_db.py

# -- Distribuicoes Python --------------------------------------
*.egg-info/
.eggs/
pip-wheel-metadata/

# -- Arquivos temporarios do script Windows --------------------
tools/*.tmp
tools/*.log
